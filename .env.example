# Local development placeholders only.
# Copy to .env and replace values locally. Do not commit real secrets.

POSTGRES_USER=dataanon
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=dataanon

STAGING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/dataanon?currentSchema=staging
ANONYMIZED_DATASOURCE_URL=jdbc:postgresql://postgres:5432/dataanon?currentSchema=anonymized
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/dataanon?currentSchema=anonymized

DATASOURCE_USERNAME=dataanon
DATASOURCE_PASSWORD=replace-with-local-password
SPRING_DATASOURCE_USERNAME=dataanon
SPRING_DATASOURCE_PASSWORD=replace-with-local-password

JWT_SECRET=replace-with-32-plus-character-local-secret
JWT_EXPIRATION=28800000

REDIS_HOST=redis
REDIS_PORT=6379
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
